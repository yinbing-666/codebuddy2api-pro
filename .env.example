# CodeBuddy2API Pro configuration example.
# Copy to .env and fill in your own values. Never commit the real .env.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Encryption key for stored credentials (choose a long random string).
# CODEBUDDY_STORAGE_ENCRYPTION_KEY=change-me-to-a-long-random-string
# SQLite backend (default) or Postgres (set DATABASE_URL to switch).
# CODEBUDDY_STORAGE_BACKEND=sqlite
# DATABASE_URL=postgres://user:pass@host:5432/codebuddy2api

# ---------------------------------------------------------------------------
# Upstream endpoint
# ---------------------------------------------------------------------------
# CodeBuddy CN: https://copilot.tencent.com (default)
# WorkBuddy Intl: https://www.workbuddy.ai
# CodeBuddy Intl: https://www.codebuddy.ai
# CODEBUDDY_API_ENDPOINT=https://www.workbuddy.ai

# ---------------------------------------------------------------------------
# Outbound proxy (optional, any HTTP proxy works)
# ---------------------------------------------------------------------------
# Bun's native fetch honors these env vars. Use any provider -- Webshare,
# Bright Data, a self-hosted relay, your own exit node, etc.
# Format: http://user:pass@host:port  (credentials optional)
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080
# HTTP_PROXY=http://user:pass@proxy.example.com:8080

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# CODEBUDDY_INTERNET_ENVIRONMENT=public
# CODEBUDDY_LOG_LEVEL=info
# PORT=8001
# HOSTNAME=0.0.0.0
